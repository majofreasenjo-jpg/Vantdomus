APP_ENV=production
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/vantdomus
DB_PATH=

JWT_SECRET=CHANGE_ME_32_PLUS_CHARACTER_JWT_SECRET
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRES_SECONDS=28800

VANTDOMUS_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
VANTDOMUS_APP_PUBLIC_URL=https://app.example.com

VANTDOMUS_API_RATE_LIMIT_MODE=redis
VANTDOMUS_API_RATE_LIMIT_REQUESTS=600
VANTDOMUS_API_RATE_LIMIT_WINDOW_SECONDS=60
VANTDOMUS_API_RATE_LIMIT_EXEMPT_PATHS=/health
VANTDOMUS_REDIS_URL=redis://CHANGE_ME_REDIS_HOST:6379/0
VANTDOMUS_REDIS_TIMEOUT_SECONDS=2

VANTDOMUS_MFA_SECRET_KEY=CHANGE_ME_32_PLUS_CHARACTER_MFA_KEY
# During rotation:
# VANTDOMUS_MFA_SECRET_KEYS=CHANGE_ME_ACTIVE_32_PLUS_CHARACTER_KEY,CHANGE_ME_PREVIOUS_32_PLUS_CHARACTER_KEY
VANTDOMUS_REQUIRE_VERIFIED_EMAIL_FOR_SENSITIVE_ACTIONS=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=security@example.com

VANTDOMUS_SECURITY_ALERT_WEBHOOK_URL=https://alerts.example.com/vantdomus
VANTDOMUS_SECURITY_ALERT_MIN_SEVERITY=high
VANTDOMUS_SECURITY_ALERT_TIMEOUT_SECONDS=5
VANTDOMUS_SECURITY_ALERT_SIGNING_SECRET=CHANGE_ME_32_PLUS_CHARACTER_ALERT_SIGNING_SECRET

VANTDOMUS_BACKUP_ENCRYPTION_KEY=CHANGE_ME_32_PLUS_CHARACTER_BACKUP_KEY
VANTDOMUS_RETENTION_CLEANUP_GRACE_DAYS=30

VANTDOMUS_PRIVATE_UPLOAD_DIR=/var/lib/vantdomus/private_uploads
VANTDOMUS_ENABLE_PUBLIC_UPLOADS=false
VANTDOMUS_MAX_UPLOAD_BYTES=10485760
VANTDOMUS_ALLOWED_UPLOAD_MIMES=application/pdf,image/png,image/jpeg,text/plain,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel
VANTDOMUS_ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.xlsx,.xls

VANTDOMUS_MALWARE_SCAN_MODE=clamav
VANTDOMUS_CLAMAV_HOST=clamav
VANTDOMUS_CLAMAV_PORT=3310
VANTDOMUS_CLAMAV_TIMEOUT_SECONDS=5
VANTDOMUS_MALWARE_FAIL_CLOSED=true
VANTDOMUS_MALWARE_SIGNATURES=

VANTDOMUS_SIGNED_URL_MAX_TTL_SECONDS=86400
VANTDOMUS_WEBHOOK_RATE_LIMIT_EVENTS=60
VANTDOMUS_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
VANTDOMUS_GATEWAY_TOKEN_TTL_DAYS=90

VANTDOMUS_ALLOW_DEMO_SEED=false
VANTDOMUS_ALLOW_NOTIFICATION_TESTS=false

VANTDOMUS_MIN_PASSWORD_LENGTH=10
VANTDOMUS_AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
VANTDOMUS_AUTH_FAILED_LOGIN_WINDOW_SECONDS=900
VANTDOMUS_MFA_RECOVERY_CODE_COUNT=8
