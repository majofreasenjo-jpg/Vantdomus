# ============================================================================
# VantDomus API environment template.
#
# Copy to .env (gitignored) and replace empty / placeholder values.
# In staging/production, app/config.py refuses to start with the known-default
# placeholder strings, so they must be replaced with real high-entropy values.
#
# Generate strong secrets:
#   bash:   openssl rand -hex 32
#   pwsh:   [Convert]::ToHexString((1..32 | %{ Get-Random -Max 256 }))
# ============================================================================

APP_ENV=local
DB_PATH=vantdomus.db
DATABASE_URL=
# 32+ random bytes. NEVER reuse across environments.
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRES_SECONDS=28800
VANTDOMUS_API_RATE_LIMIT_MODE=memory
VANTDOMUS_API_RATE_LIMIT_REQUESTS=600
VANTDOMUS_API_RATE_LIMIT_WINDOW_SECONDS=60
VANTDOMUS_API_RATE_LIMIT_EXEMPT_PATHS=/health
VANTDOMUS_REDIS_URL=redis://127.0.0.1:6379/0
VANTDOMUS_REDIS_TIMEOUT_SECONDS=2
VANTDOMUS_SECURITY_ALERT_WEBHOOK_URL=
VANTDOMUS_SECURITY_ALERT_MIN_SEVERITY=high
VANTDOMUS_SECURITY_ALERT_TIMEOUT_SECONDS=5
VANTDOMUS_SECURITY_ALERT_SIGNING_SECRET=
# 32+ random bytes for backup encryption.
VANTDOMUS_BACKUP_ENCRYPTION_KEY=
VANTDOMUS_RETENTION_CLEANUP_GRACE_DAYS=30
# 32+ random bytes for TOTP MFA seed encryption.
VANTDOMUS_MFA_SECRET_KEY=
# During key rotation, place the active key first and previous keys after it:
# VANTDOMUS_MFA_SECRET_KEYS=ACTIVE_32_PLUS_CHARACTER_KEY,PREVIOUS_32_PLUS_CHARACTER_KEY
VANTDOMUS_ALLOW_DEMO_SEED=false
VANTDOMUS_ALLOW_NOTIFICATION_TESTS=false
VANTDOMUS_ENABLE_PUBLIC_UPLOADS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VANTDOMUS_APP_PUBLIC_URL=http://127.0.0.1:3000
VANTDOMUS_ALLOWED_HOSTS=127.0.0.1,localhost
VANTDOMUS_REQUIRE_VERIFIED_EMAIL_FOR_SENSITIVE_ACTIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VANTDOMUS_MIN_PASSWORD_LENGTH=6
VANTDOMUS_AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
VANTDOMUS_AUTH_FAILED_LOGIN_WINDOW_SECONDS=900
VANTDOMUS_MFA_RECOVERY_CODE_COUNT=8
VANTDOMUS_PRIVATE_UPLOAD_DIR=private_uploads
VANTDOMUS_MAX_UPLOAD_BYTES=10485760
VANTDOMUS_ALLOWED_UPLOAD_MIMES=application/pdf,image/png,image/jpeg,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel
VANTDOMUS_ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.csv,.docx,.pptx,.xlsx,.xls
VANTDOMUS_MALWARE_SCAN_MODE=basic
VANTDOMUS_CLAMAV_HOST=127.0.0.1
VANTDOMUS_CLAMAV_PORT=3310
VANTDOMUS_CLAMAV_TIMEOUT_SECONDS=5
VANTDOMUS_MALWARE_FAIL_CLOSED=true
VANTDOMUS_MALWARE_SIGNATURES=
VANTDOMUS_SIGNED_URL_MAX_TTL_SECONDS=86400
VANTDOMUS_WEBHOOK_RATE_LIMIT_EVENTS=60
VANTDOMUS_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
VANTDOMUS_GATEWAY_TOKEN_TTL_DAYS=90
VANTDOMUS_AI_FEATURES_ENABLED=true
VANTDOMUS_AI_PROVIDER=openai
VANTDOMUS_AI_KEYS_MODE=platform
VANTDOMUS_SECRET_MANAGER=env
OPENAI_API_KEY=
VANTDOMUS_STT_MODEL=gpt-4o-mini-transcribe
VANTDOMUS_TTS_MODEL=gpt-4o-mini-tts
VANTDOMUS_TTS_VOICE=alloy
VANTDOMUS_AUDIO_MAX_BYTES=26214400
